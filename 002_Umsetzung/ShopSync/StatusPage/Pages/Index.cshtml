@page
@model IndexModel

<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8" />
	<title>Log Viewer</title>
    <style>
        textarea {
          width: 50%;
          height: 80%;
            min-height: 500px;
          font-family: monospace;
          overflow-y: scroll;
        }

        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
        }

        .status {
            display: flex;
            align-items: center;
            font-family: Arial, sans-serif;
            font-size: 16px;
        }

        .status-dot {
            width: 10px;
            height: 10px;
            background-color: green;
            border-radius: 50%;
            margin-right: 8px;
        }
    </style>
</head>
<body>
<h1>Log Entries</h1>
<div class="status">
	<div class="status-dot"></div>
	<span>Database Status: OK</span>
</div>
<textarea >
	@string.Join(Environment.NewLine, Model.Logs)
</textarea>
</body>
</html>